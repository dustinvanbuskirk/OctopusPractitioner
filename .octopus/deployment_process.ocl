step "run-a-script" {
    name = "Run a Script"

    action {
        action_type = "Octopus.Script"
        is_required = true
        properties = {
            Octopus.Action.Script.ScriptBody = <<-EOT
                Param(
                    [switch]$EnableVerbose = $true,
                    [switch]$EnableTrace   = $true
                )
                
                # --- Debugging defaults ---
                $ErrorActionPreference = "Stop"
                Set-StrictMode -Version Latest
                
                if ($EnableVerbose) { $VerbosePreference = "Continue" } else { $VerbosePreference = "SilentlyContinue" }
                if ($EnableTrace)   { Set-PSDebug -Trace 1 }
                
                Write-Verbose "=== Starting script: $(Split-Path -Leaf $PSCommandPath) ==="
                Write-Verbose ("PowerShell Version: " + $PSVersionTable.PSVersion.ToString())
                Write-Verbose ("Invocation args: " + ($MyInvocation.UnboundArguments -join ' '))
                
                # Helper to pretty-print objects safely
                # Helper to pretty-print objects safely
                function Write-DebugObject {
                    param(
                        [Parameter(ValueFromPipeline=$true)]$Object,
                        [int]$Depth,
                        [string]$Label
                    )
                    if (-not $PSBoundParameters.ContainsKey('Depth') -or $null -eq $Depth) { $Depth = 3 }
                    if (-not $PSBoundParameters.ContainsKey('Label') -or [string]::IsNullOrEmpty($Label)) { $Label = "Object" }
                
                    
                }
                
                Write-Verbose "$Label (string): $Object"
                
                $ErrorActionPreference = "Stop";
                
                # Connection Variables
                $apiKey = "#{apiKey}"
                $octopusUrl = "#{octopusUrl}"
                
                # Do Not Change
                $Header =  @{ "X-Octopus-ApiKey" = $apiKey }
                
                # Release variables
                $projectName = "#{Octopus.Project.Name}"
                $releaseVersion = "#{Octopus.Release.Number}"
                $environmentName = "#{Octopus.Environment.Name}"
                
                # Set variables to hold Id values
                Write-Verbose "HTTP GET $octopusUrl/api/projects?name=$projectName"
                $projectId = ((Invoke-RestMethod -Verbose -Method Get -Uri "$octopusUrl/api/projects?name=$projectName" -Headers $header).Items).Id
                Write-Verbose "HTTP GET $octopusUrl/api/Environments?name=$environmentName"
                $environmentId = ((Invoke-RestMethod -Verbose -Method Get -Uri "$octopusUrl/api/Environments?name=$environmentName" -Headers $header).Items).Id
                
                # Query API for Task Details, Filter and Process.
                try {
                    # Fetch cancelled tasks for project and release
                Write-Verbose "HTTP GET $octopusURL/api/tasks?skip=0&take=1000&environment=$environmentId&project=$projectId"
                    $cancelledTasks = (Invoke-RestMethod -Verbose -Method Get -Uri "$octopusURL/api/tasks?skip=0&take=1000&environment=$environmentId&project=$projectId" -Headers $header).Items | Where-Object { $_.State -match "Cancel" -and $_.Description -like "*release $releaseVersion*" }
                    Write-Output "There are $($cancelledTasks.Count) cancelled tasks for $projectName release $releaseVersion to $environmentName"
                
                    # Filter last cancelled task
                    $lastCancelledTask = ($cancelledTasks).Id | Sort-Object { [int]($_.Id -replace '[^0-9]', '') } -Descending | Select-Object -First 1
                    Write-Output "The last cancelled task for $projectName release $releaseVersion to $environmentName is $lastCancelledTask"
                
                    # Fetch all tasks for project and release since last cancellation
                Write-Verbose "HTTP GET $octopusURL/api/tasks?skip=0&take=1000&environment=$environmentId&project=$projectId"
                    $allTasks = (Invoke-RestMethod -Verbose -Method Get -Uri "$octopusURL/api/tasks?skip=0&take=1000&environment=$environmentId&project=$projectId" -Headers $header).Items | Where-Object { $_.Id -gt $lastCancelledTask -and $_.Description -like "*release $releaseVersion*" }
                    Write-Output "There are $($allTasks.Count) tasks to validate for $projectName release $releaseVersion to $environmentName"
                
                    # Filter failed tasks
                Write-Verbose "HTTP GET $octopusURL/api/tasks?skip=0&take=1000&environment=$environmentId&project=$projectId"
                    $failedTasks = (Invoke-RestMethod -Verbose -Method Get -Uri "$octopusURL/api/tasks?skip=0&take=1000&environment=$environmentId&project=$projectId" -Headers $header).Items | Where-Object { $_.Id -gt $lastCancelledTask -and $_.State -eq "Failed" -and $_.Description -like "*release $releaseVersion*" }
                    Write-Output "There are $($failedTasks.Count) failed tasks for $projectName release $releaseVersion to $environmentName"
                
                    # Count failed tasks and prepare to cancel scheduled deployments if threshold met
                    If(($failedTasks.Id).Count -ge 3)
                    {
                        # Filter scheduled tasks
                        $scheduledTasks = $allTasks | Where-Object { $_.State -eq "Queued" -and $_.HasBeenPickedUpByProcessor -eq $false -and $_.Name -eq "Deploy" -and $_.Description -like "*release $releaseVersion*" }
                        # Count scheduled tasks and cancel any that are found
                        if ($scheduledTasks.Count -eq 0) {
                            Write-Output "No scheduled deployments found for $projectName release $releaseVersion to $environmentName. Nothing to cancel."
                        } else {
                            Write-Output "Cancelling all scheduled deployments for $projectName release $releaseVersion to $environmentName"
                            #Cancel all scheduled tasks
                            foreach ($task in $scheduledTasks)
                            {
                Write-Verbose "HTTP POST $octopusURL/api/tasks/$($task.Id)/cancel"
                                Invoke-RestMethod -Verbose -Method Post -Uri "$octopusURL/api/tasks/$($task.Id)/cancel" -Headers $header -UseBasicParsing | Out-Null
                            }
                        }
                    }
                    Else
                    {
                        Write-Output "Number of failed deployments for $projectName release $releaseVersion to $env is below the threshold (found $($failedTasks.Count), threshold is 3). No scheduled tasks will be cancelled."
                        break
                    }
                }
                catch {
                    Write-Error -Message "No deployments found for $projectName release $releaseVersion to $environmentName. Nothing to action."
                    Write-Error ("ERROR: " + $_)
                    if ($_.InvocationInfo) { Write-Error ("At: " + $_.InvocationInfo.PositionMessage) }
                    if ($_.Exception.Response -and ($_.Exception.Response -is [System.Net.HttpWebResponse])) {
                        $resp = $_.Exception.Response
                        Write-Error ("HTTP Status: " + [int]$resp.StatusCode + " " + $resp.StatusDescription)
                        try { $reader = New-Object System.IO.StreamReader($resp.GetResponseStream()); $body = $reader.ReadToEnd(); Write-Error ("Response body: " + $body) } catch {}
                    }
                    if ($_.Exception.Response -and ($_.Exception.Response -is [System.Net.HttpWebResponse])) {
                        $resp = $_.Exception.Response
                        Write-Error ("HTTP Status: " + [int]$resp.StatusCode + " " + $resp.StatusDescription)
                        try {
                            $body = ""
                            $stream = $resp.GetResponseStream()
                            if ($null -ne $stream) {
                                $reader = New-Object System.IO.StreamReader($stream)
                                try { $body = $reader.ReadToEnd() } finally { $reader.Dispose() }
                            }
                            if ($body) { Write-Error ("Response body: " + $body) } else { Write-Verbose "Response body empty or unreadable." }
                        } catch {
                            Write-Verbose ("Failed to read response body: " + $_.Exception.Message)
                        }
                    }
                    throw
                }
                
                finally {
                    Write-Verbose "=== Try/Catch finally block reached ==="
                }
                Write-Verbose "=== Script completed successfully ==="
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
            OctopusUseBundledTooling = "False"
        }
        worker_pool = "hosted-windows"
    }
}

step "calculate-deployment-mode" {
    name = "Calculate Deployment Mode"

    action {
        properties = {
            Octopus.Action.Template.Id = "ActionTemplates-6"
            Octopus.Action.Template.Version = "5"
        }
        worker_pool = "hosted-windows"
        worker_pool_variable = ""
    }
}

step "run-configure-sql-server-runbook" {
    condition = "Variable"
    name = "Run Configure SQL Server Runbook"
    properties = {
        Octopus.Step.ConditionVariableExpression = "#{unless Octopus.Deployment.Error}#{Octopus.Action[Calculate Deployment Mode].Output.RunOnDeploy}#{/unless}"
    }

    action {
        properties = {
            Octopus.Action.AutoRetry.MaximumCount = "3"
            Octopus.Action.AutoRetry.MinimumBackoff = "15"
            Octopus.Action.Template.Id = "ActionTemplates-5"
            Octopus.Action.Template.Version = "18"
            Run.Runbook.Api.Key = "#{Project.Runbook.Api.Key}"
            Run.Runbook.AutoApproveManualInterventions = "No"
            Run.Runbook.Base.Url = "#{Octopus.Web.ServerUri}"
            Run.Runbook.CancelInSeconds = "1800"
            Run.Runbook.CustomNotes.Toggle = "False"
            Run.Runbook.DateTime = "N/A"
            Run.Runbook.Environment.Name = "#{Octopus.Environment.Name}"
            Run.Runbook.Machines = "N/A"
            Run.Runbook.ManualIntervention.EnvironmentToUse = "#{Octopus.Environment.Name}"
            Run.Runbook.Name = "Configure SQL Server"
            Run.Runbook.Project.Name = "#{Octopus.Project.Name}"
            Run.Runbook.Space.Name = "#{Octopus.Space.Name}"
            Run.Runbook.UsePublishedSnapShot = "True"
            Run.Runbook.Waitforfinish = "True"
        }
        worker_pool = "hosted-windows"
    }
}

step "generate-what-if-report" {
    condition = "Variable"
    name = "Generate What If Report"
    properties = {
        Octopus.Step.ConditionVariableExpression = "#{unless Octopus.Deployment.Error}#{Octopus.Action[Calculate Deployment Mode].Output.RunOnDeploy}#{/unless}"
    }

    action {
        is_required = true
        properties = {
            Database.Deploy.ConnectionString = "#{Project.Connection.String}"
            Database.Deploy.Package = "{\"PackageId\":\"Trident.Database\",\"FeedId\":\"octopus-server-built-in\"}"
            Database.Deploy.PathToDBUpExe = ".\\Octopus.Trident.Database.DbUpp"
            Database.Deploy.ReportPath = "#{Project.Database.Report.Path}"
            Database.Deploy.WhatIf = "True"
            Octopus.Action.Template.Id = "ActionTemplates-4"
            Octopus.Action.Template.Version = "14"
        }
        worker_pool = "hosted-windows"

        packages "Database.Deploy.Package" {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "Trident.Database"
            properties = {
                Extract = "True"
                PackageParameterName = "Database.Deploy.Package"
                Purpose = ""
                SelectionMode = "deferred"
            }
        }
    }
}

step "dba-review-delta-script" {
    condition = "Variable"
    name = "DBA Review Delta Script"
    properties = {
        Octopus.Step.ConditionVariableExpression = "#{unless Octopus.Deployment.Error}#{Octopus.Action[Calculate Deployment Mode].Output.RunOnDeploy}#{/unless}"
    }

    action {
        action_type = "Octopus.Manual"
        environments = ["staging"]
        properties = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "False"
            Octopus.Action.Manual.Instructions = "Please review the delta script that was generated."
            Octopus.Action.Manual.ResponsibleTeamIds = "dba,global/octopus-managers"
            Octopus.Action.RunOnServer = "false"
        }
    }
}

step "deploy-database-changes" {
    condition = "Variable"
    name = "Deploy Database Changes"
    properties = {
        Octopus.Step.ConditionVariableExpression = "#{unless Octopus.Deployment.Error}#{Octopus.Action[Calculate Deployment Mode].Output.RunOnDeploy}#{/unless}"
    }

    action {
        properties = {
            Database.Deploy.ConnectionString = "#{Project.Connection.String}"
            Database.Deploy.Package = "{\"PackageId\":\"Trident.Database\",\"FeedId\":\"octopus-server-built-in\"}"
            Database.Deploy.PathToDBUpExe = ".\\Octopus.Trident.Database.DbUp"
            Database.Deploy.ReportPath = "#{Project.Database.Report.Path}"
            Database.Deploy.WhatIf = "False"
            Octopus.Action.Template.Id = "ActionTemplates-4"
            Octopus.Action.Template.Version = "14"
        }
        worker_pool = "hosted-windows"

        packages "Database.Deploy.Package" {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "Trident.Database"
            properties = {
                Extract = "True"
                PackageParameterName = "Database.Deploy.Package"
                Purpose = ""
                SelectionMode = "deferred"
            }
        }
    }
}

step "deploy-trident-web-application" {
    name = "Deploy Trident Web Application"
    properties = {
        Octopus.Action.TargetRoles = "trident-web"
    }

    action {
        action_type = "Octopus.TentaclePackage"
        properties = {
            Octopus.Action.EnabledFeatures = "Octopus.Features.JsonConfigurationVariables"
            Octopus.Action.Package.DownloadOnTentacle = "False"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.JsonConfigurationVariablesTargets = "appSettings.json"
            Octopus.Action.Package.PackageId = "Trident.Web"
            Octopus.Action.RunOnServer = "false"
        }
        worker_pool_variable = ""

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "Trident.Web"
            properties = {
                SelectionMode = "immediate"
            }
        }
    }
}

step "verify-application" {
    name = "Verify Application"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.Script.ScriptBody = "exit 1"
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            OctopusUseBundledTooling = "False"
        }
        worker_pool = "hosted-windows"
    }
}

step "notify-team-of-deployment-status" {
    condition = "Always"
    name = "Notify team of deployment status"

    action {
        properties = {
            Octopus.Action.Template.Id = "ActionTemplates-1"
            Octopus.Action.Template.Version = "15"
            ssn_Color = "good"
            ssn_HookUrl = "#{Notification.Slack.Webhook.Url}"
            ssn_IconUrl = "https://octopus.com/content/resources/favicon.png"
            ssn_Message = "#{Notification.Body.Text}"
            ssn_Title = "#{Notification.Subject.Text}"
            ssn_Username = "Octopus Deploy"
        }
        worker_pool = "hosted-windows"
    }
}